{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/backend-gateway.mjs": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/backend-gateway?__backend_route=:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "prenota.makaipigneto.it"
        }
      ],
      "destination": "https://www.makaipigneto.it/prenotazioni",
      "permanent": true
    },
    {
      "source": "/prenotazioni",
      "has": [
        {
          "type": "host",
          "value": "prenota.makaipigneto.it"
        }
      ],
      "destination": "https://www.makaipigneto.it/prenotazioni",
      "permanent": true
    }
  ]
}
