# =============================================================================
# SITO MAKAI — variabili del progetto Vercel "sito-makai"
# =============================================================================
# Dal cutover di ottobre 2026 il Sito NON contiene più il backend Python:
# il frontend Vite viene servito da Vercel e /api/* viene inoltrato al Backend
# Makai tramite api/backend-gateway.mjs.
#
# Dove si impostano:
#   - Produzione: Vercel -> progetto sito-makai -> Settings -> Environment
#     Variables -> Production (poi Redeploy).
#   - Locale: NON serve alcun .env. Vite inoltra già /api a
#     http://127.0.0.1:8000 (vedi vite.config.js).
#
# Le due variabili qui sotto sono SOLO server-side: non usare il prefisso VITE_
# e non esporle al browser.
# =============================================================================


# [OBBLIGATORIA] Origine HTTPS del Backend Makai.
# Deve essere una sola origine: senza /api, senza path e senza slash finale.
API_PROXY_TARGET=https://backend-makai.vercel.app

# [OBBLIGATORIA] Almeno 32 caratteri, senza spazi.
# Deve essere IDENTICA a MAKAI_SITE_PROXY_SECRET del progetto Vercel
# "backend-makai". Il gateway la invia nell'header X-Makai-Site-Proxy-Key.
MAKAI_SITE_PROXY_SECRET=


# -----------------------------------------------------------------------------
# NON servono in questo progetto
# -----------------------------------------------------------------------------
# Il Sito non usa più direttamente:
#   DATABASE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   ADMIN_*, CHAT_SESSION_SECRET, MAKAI_PUSH_SECRET, ALLOWED_ORIGINS.
# Appartengono al progetto Vercel "backend-makai" (database, auth, email, push)
# oppure alla configurazione Supabase. Se le trovi ancora nel vecchio .env del
# Sito sono residui del backend precedente e non vengono lette dal gateway.
#
# Il frontend non usa variabili VITE_* proprie: BASE_URL è fornita da Vite.
# -----------------------------------------------------------------------------
