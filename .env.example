# Database Supabase/Postgres per le prenotazioni
DATABASE_URL=

# Data API Supabase per il menu pubblico in sola lettura
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Account gestore (ADMIN_API_KEY resta supportata come vecchia password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Segreto casuale indipendente dalla password (almeno 32 caratteri)
ADMIN_SESSION_SECRET=
# Facoltativo: segreto per le sessioni della chat (almeno 32 caratteri).
# Se vuoto, usa ADMIN_SESSION_SECRET con una firma separata dall'accesso gestore.
CHAT_SESSION_SECRET=
# false solo per sviluppo locale HTTP; true in produzione HTTPS
ADMIN_COOKIE_SECURE=true
# Cancellazione automatica dopo RETENTION_DAYS: disattivata per default
BOOKINGS_AUTO_CLEANUP=false

# Contatti del locale
MAKAI_PHONE=+393397514140

# Domini autorizzati a chiamare il backend, separati da virgola
ALLOWED_ORIGINS=http://localhost:5173

# Stessa chiave server-only configurata nel progetto Vercel Agenda.
AGENDA_BACKEND_SECRET=
